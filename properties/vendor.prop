# Fingerprint
persist.vendor.fingerprint.sensor_location=720|2882|124

# System properties
ro.product.property_source_order=odm,vendor,product,system_ext,system
ro.soc.manufacturer=Qualcomm

# HDR display support
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.use_color_management=true

# Keep high-frequency vendor display-algorithm samples out of logcat.
log.tag.libsensor-displayalgo=W

# Enable framebuffer-based compensation for the under-display light sensor,
# so the screen's own light (e.g. white content over the sensor area) is
# subtracted from the ALS reading instead of feeding back into auto-brightness.
persist.vendor.sensors.used.framebuffer=1
